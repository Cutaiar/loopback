#!/usr/bin/env bash
#
# audio-route — point macOS at BlackHole so Hyperspace can see system audio,
#               and put everything back exactly as it was.
#
#   audio-route on          snapshot the current devices, then route through
#                           BlackHole: output to a Multi-Output Device (so you
#                           still hear the audio), input to BlackHole itself.
#                           If no Multi-Output Device exists and the run is
#                           interactive, offers to create one first.
#   audio-route on --bare   as above but route output to bare BlackHole 2ch,
#                           silencing the speakers. Use this when another app
#                           processes the BlackHole feed and plays back the
#                           result itself — otherwise you'd hear the dry
#                           signal on top of the processed one.
#   audio-route off         restore the snapshot and discard it.
#   audio-route status      what is selected now, and whether a snapshot is held.
#
# The snapshot is taken *before* anything changes and stores device UIDs, not
# names, so a renamed device still restores. `on` twice does not overwrite the
# snapshot — the first one is the state you actually want back.
#
# Override the auto-detected targets with LOOPBACK_OUTPUT / LOOPBACK_INPUT
# (a UID, an exact name, or any substring of a name).

set -euo pipefail

# resolve symlinks so a $PATH shim (e.g. ~/.local/bin/audio-route -> the real
# script in loopback/) still finds audiodev.swift beside the source, not
# beside the symlink
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  link="$(readlink "$SELF")"
  case "$link" in
    /*) SELF="$link" ;;
    *)  SELF="$(dirname "$SELF")/$link" ;;
  esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
SRC="$HERE/audiodev.swift"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/loopback"
BIN="$CACHE/audiodev"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/loopback"
SNAP="$STATE/audio-snapshot"

BARE=0   # set by --bare on the "on" command

die() { printf 'audio-route: %s\n' "$1" >&2; exit "${2:-1}"; }

# the helper is compiled once and reused; rebuilt only when its source changes
build() {
  [[ -f "$SRC" ]] || die "missing $SRC"
  if [[ ! -x "$BIN" || "$SRC" -nt "$BIN" ]]; then
    command -v swiftc >/dev/null || die "swiftc not found — install the Xcode command line tools: xcode-select --install"
    mkdir -p "$CACHE"
    swiftc -O -o "$BIN" "$SRC" || die "could not build the CoreAudio helper"
  fi
}

name_of() { cut -f2- <<<"$1"; }        # a device line is UID<TAB>name
uid_of()  { cut -f1  <<<"$1"; }

# The Multi-Output Device is an output whose name mentions BlackHole but is not
# a bare BlackHole device — "BlackHole + MBP Speakers" rather than "BlackHole
# 2ch". That distinction matters: routing straight to BlackHole works, but you
# stop hearing anything, which is never what someone wants.
pick_output() {
  local list; list="$("$BIN" list out)"
  if [[ -n "${LOOPBACK_OUTPUT:-}" ]]; then printf '%s\n' "$LOOPBACK_OUTPUT"; return; fi
  local multi bare
  bare="$(grep -i 'blackhole' <<<"$list" | grep -i $'\t''blackhole [0-9]*ch$' | head -1 || true)"
  # --bare skips the Multi-Output search: caller wants the audio to go into
  # BlackHole only, because another program will process it and play back.
  if (( BARE == 0 )); then
    multi="$(grep -i 'blackhole' <<<"$list" | grep -iv $'\t''blackhole [0-9]*ch$' | head -1 || true)"
    if [[ -n "$multi" ]]; then uid_of "$multi"; return; fi
  fi
  [[ -n "$bare" ]] || die "no BlackHole output device found. Install it with: brew install blackhole-2ch" 2
  if (( BARE == 0 )); then
    printf 'audio-route: no Multi-Output Device found, using "%s" directly — you will not hear the audio.\n' \
      "$(name_of "$bare")" >&2
    printf 'audio-route: make one in Audio MIDI Setup (+ > Create Multi-Output Device, tick BlackHole and your speakers).\n' >&2
  fi
  uid_of "$bare"
}

# The input must be the BlackHole the output actually feeds: a Multi-Output
# Device feeds whichever BlackHole is among its sub-devices, and a bare
# BlackHole output is its own input. With both 2ch and 16ch installed,
# "any BlackHole" can guess the other one, and the reader records silence.
# Called after the output is applied, so it inspects the real default output.
pick_input() {
  if [[ -n "${LOOPBACK_INPUT:-}" ]]; then printf '%s\n' "$LOOPBACK_INPUT"; return; fi
  local ins out_line fed
  ins="$("$BIN" list in)"
  out_line="$("$BIN" get out)"
  fed="$("$BIN" subs "$(uid_of "$out_line")" | grep -i 'blackhole' | head -1 || true)"
  [[ -n "$fed" ]] || fed="$(grep -i $'\t''blackhole [0-9]*ch$' <<<"$out_line" || true)"
  if [[ -n "$fed" ]] && grep -qF "$(uid_of "$fed")"$'\t' <<<"$ins"; then
    uid_of "$fed"; return
  fi
  local bh; bh="$(grep -i 'blackhole' <<<"$ins" | head -1 || true)"
  [[ -n "$bh" ]] || die "no BlackHole input device found. Install it with: brew install blackhole-2ch" 2
  uid_of "$bh"
}

# First-run niceness: when `on` would fall back to bare BlackHole because no
# Multi-Output Device exists, offer to create one — the same stacked aggregate
# Audio MIDI Setup builds — pairing the current output with BlackHole. Only
# when interactive; scripted runs keep the warn-and-fall-back behavior.
offer_multi_output() {
  (( BARE == 0 )) || return 0
  [[ -z "${LOOPBACK_OUTPUT:-}" ]] || return 0
  [[ -t 0 && -t 2 ]] || return 0
  local list bare cur name made
  list="$("$BIN" list out)"
  grep -i 'blackhole' <<<"$list" | grep -qiv $'\t''blackhole [0-9]*ch$' && return 0
  bare="$(grep -i $'\t''blackhole 2ch$' <<<"$list" | head -1 || true)"
  [[ -n "$bare" ]] || bare="$(grep -i $'\t''blackhole [0-9]*ch$' <<<"$list" | head -1 || true)"
  [[ -n "$bare" ]] || return 0    # no BlackHole at all — pick_output explains the install
  cur="$("$BIN" get out)"
  grep -qi 'blackhole' <<<"$cur" && return 0   # already on BlackHole; nothing sane to pair
  name="BlackHole + $(name_of "$cur")"
  printf 'audio-route: no Multi-Output Device found — without one, routing to "%s" silences your speakers.\n' \
    "$(name_of "$bare")" >&2
  printf 'audio-route: create "%s" now? It persists and appears in Audio MIDI Setup. [y/N] ' "$name" >&2
  local reply; read -r reply
  case "$reply" in y|Y|yes|Yes|YES) ;; *) return 0 ;; esac
  if made="$("$BIN" make-multi "$name" "$(uid_of "$cur")" "$(uid_of "$bare")")"; then
    printf 'audio-route: created "%s".\n' "$(name_of "$made")" >&2
  else
    printf 'audio-route: could not create the Multi-Output Device — continuing without it.\n' >&2
  fi
}

# set one default device and say so, or stop — never claim a set that failed
apply() {   # kind spec label
  local out
  if ! out="$("$BIN" set "$1" "$2")"; then
    die "could not set the $1put device. Nothing else changed; run \"audio-route off\" to undo the rest." 2
  fi
  printf '%-7s →  %s\n' "$3" "$(name_of "$out")"
}

cmd_on() {
  local out_now in_now
  out_now="$("$BIN" get out)"; in_now="$("$BIN" get in)"

  if [[ -f "$SNAP" ]]; then
    printf 'audio-route: snapshot already held from an earlier "on" — keeping it.\n'
  else
    mkdir -p "$STATE"
    { printf 'out\t%s\n' "$out_now"; printf 'in\t%s\n' "$in_now"; } > "$SNAP"
    printf 'Snapshot   out: %s\n           in:  %s\n' "$(name_of "$out_now")" "$(name_of "$in_now")"
  fi

  offer_multi_output

  # a failed set must not be reported as success — and the snapshot is already
  # written by now, so a half-applied change is still undoable with "off".
  # The output is applied first: pick_input reads it back to find the
  # matching BlackHole device.
  local target_out target_in
  target_out="$(pick_output)"
  apply out "$target_out" "Output"
  target_in="$(pick_input)"
  apply in  "$target_in"  "Input"
  printf '\nSystem audio now reaches the browser. Run "audio-route off" to undo.\n'
}

cmd_off() {
  [[ -f "$SNAP" ]] || die "no snapshot to restore — nothing to undo." 2
  local failed=0 line kind spec
  while IFS= read -r line; do
    kind="$(cut -f1 <<<"$line")"; spec="$(cut -f2 <<<"$line")"
    if out="$("$BIN" set "$kind" "$spec" 2>&1)"; then
      printf '%-7s →  %s\n' "$([[ $kind == out ]] && echo Output || echo Input)" "$(name_of "$out")"
    else
      printf 'audio-route: could not restore the %sput device (%s) — it may be unplugged.\n' "$kind" "$out" >&2
      failed=1
    fi
  done < "$SNAP"
  rm -f "$SNAP"
  (( failed == 0 )) || exit 2
  printf '\nRestored. Snapshot discarded.\n'
}

cmd_status() {
  printf 'Output     %s\n' "$(name_of "$("$BIN" get out)")"
  printf 'Input      %s\n' "$(name_of "$("$BIN" get in)")"
  if [[ -f "$SNAP" ]]; then
    printf 'Snapshot   held (from "on"):\n'
    while IFS= read -r line; do
      printf '           %-4s %s\n' "$(cut -f1 <<<"$line")" "$(cut -f3 <<<"$line")"
    done < "$SNAP"
  else
    printf 'Snapshot   none\n'
  fi
}

CMD="${1:-status}"
case "$CMD" in
  -h|--help|help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"; exit 0 ;;
  on|off|restore|status) ;;
  *)              die "unknown command \"$CMD\" — try on, off or status." ;;
esac
shift || true

# only `on` accepts flags; be strict so typos on other commands are caught
while (( $# > 0 )); do
  case "$1" in
    --bare) [[ "$CMD" == on ]] || die "--bare only applies to \"on\""; BARE=1 ;;
    *)      die "unknown option \"$1\"" ;;
  esac
  shift
done

build
case "$CMD" in
  on)          cmd_on ;;
  off|restore) cmd_off ;;
  status)      cmd_status ;;
esac
